# Copie para web/.env (ignorado pelo git) e ajuste.

# URL base da API em produção, sem barra no final. Vazio = mesma origem (/api/...),
# que é o que funciona com proxy reverso e com o proxy do `npm run web:dev`.
VITE_API_BASE_URL=

# Só dev/preview: para onde o Vite encaminha /api e /Campaign.
VITE_API_PROXY_TARGET=http://localhost:5225

# Só se o site for servido em subcaminho (ex: /compass/). Padrão: /
# VITE_BASE_PATH=/
